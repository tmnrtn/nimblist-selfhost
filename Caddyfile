# selfhost/Caddyfile — HTTP-only reverse proxy for self-hosting.
#
# Serves plain HTTP on :80 (published by docker-compose as NIMBLIST_HTTP_PORT).
# It does NOT terminate TLS — put your own TLS-terminating proxy (NPM/Traefik/
# Caddy/nginx) in front and let it set HSTS. The job here is to merge the React
# SPA and the API onto ONE origin, because the frontend calls the API with
# relative paths (/api, /hubs, ...).

# Global options.
{
	# Trust the front proxy so inbound X-Forwarded-* pass through (#1276). Since Caddy 2.5,
	# reverse_proxy only forwards X-Forwarded-* (including X-Forwarded-Proto) from TRUSTED
	# proxies; otherwise Caddy overwrites the front proxy's `X-Forwarded-Proto: https` with
	# `http`, so the API sees Request.Scheme=http behind your TLS proxy. That downgrades every
	# scheme-derived absolute URL — notably OAuth redirect URIs become http://…/signin-google,
	# which providers reject, so CE social login breaks. A self-host front proxy
	# (NPM/Traefik/Caddy/nginx) runs on your LAN / the Docker network, so trusting the private
	# ranges is correct. Tighten to your proxy's exact CIDR if it is not on a private network.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# API
	handle /api/* {
		reverse_proxy nimblist-api:8080
	}

	# Health checks (/healthz liveness, /healthz/ready readiness) on the API
	handle /healthz* {
		reverse_proxy nimblist-api:8080
	}

	# SignalR — Caddy upgrades WebSocket connections automatically
	handle /hubs/* {
		reverse_proxy nimblist-api:8080
	}

	# Identity UI (Razor Pages: register / login / manage account)
	handle /Identity/* {
		reverse_proxy nimblist-api:8080
	}

	# OAuth provider callbacks (/signin-google, /signin-microsoft, ...)
	handle /signin-* {
		reverse_proxy nimblist-api:8080
	}

	# OpenIddict OAuth2 endpoints (authorize/token) served by the API — parity with prod
	# (#1276). Force X-Forwarded-Proto https: OpenIddict rejects non-HTTPS requests, and
	# CE is expected to run behind an upstream TLS proxy.
	handle /connect/* {
		reverse_proxy nimblist-api:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# Swagger / OpenAPI docs served by the API — parity with prod (#1276).
	handle /swagger* {
		reverse_proxy nimblist-api:8080
	}

	# Static assets served by the API (wwwroot/lib)
	handle /lib/* {
		reverse_proxy nimblist-api:8080
	}

	# Everything else → React SPA
	handle {
		reverse_proxy nimblist-frontend:80
	}

	# Security headers (TLS-specific HSTS is left to your upstream TLS proxy)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Content-Security-Policy (#1764). REPORT-ONLY here as well as on the hosted
		# service: enforcing it would risk breaking sign-in or checkout on a deployment
		# we can't observe. If you have customised the stack (a different OAuth provider,
		# your own analytics), watch your browser console for violations before switching
		# the header name to `Content-Security-Policy`.
		#
		# CE has no PayPal, no GA and no Sentry, so this is tighter than the hosted
		# policy — self-hosting genuinely has fewer third parties. The SignalR realtime
		# websocket is same-origin, which `connect-src 'self'` covers; the hosted policy
		# names its wss:// host explicitly only because it knows what that host is.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; connect-src 'self' https://accounts.google.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://accounts.google.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com https://login.microsoftonline.com https://www.facebook.com"

		# Enforced, unlike the CSP: this only ever removes capabilities. Camera and
		# microphone stay available to the app itself (recipe photo import, voice capture).
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), interest-cohort=()"
	}
}
